dcss.iancaltabiano.com {
    # Parallel HTTP/2 asset requests stalled in live Chrome acceptance.
    # Keep the tested compatibility path scoped to this hostname.
    tls {
        alpn http/1.1
    }
    header >Alt-Svc clear
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        Strict-Transport-Security "max-age=31536000"
    }
    @foreignSocket {
        path /socket
        header Origin *
        not header Origin https://dcss.iancaltabiano.com
    }
    respond @foreignSocket 403
    handle /healthz {
        root * /var/lib/dcss-health
        rewrite * /status.json
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8080 {
            # webtiles.yml sets http_xheaders, so Tornado trusts X-Real-Ip
            # before X-Forwarded-For. Overwrite any client-supplied value with
            # the real peer address so logged IPs cannot be forged.
            header_up X-Real-IP {remote_host}
        }
    }
}
