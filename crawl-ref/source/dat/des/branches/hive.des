###############################################################################
# Wax chambers, short flight lanes, and guarded inner combs.
###############################################################################
: crawl_require("dlua/vault.lua")
: crawl_require("dlua/layout/hive.lua")

NAME:   hive_end_inner_combs
PLACE:  Hive:$
ORIENT: encompass
TAGS:   transparent
KMONS:  Q = queen bee / meliai
KMONS:  W = spark wasp
KITEM:  $ = gold
KITEM:  * = any jewellery good_item / any book / any wand
TILE:   x = wall_wax
COLOUR: x = yellow
{{
    hive_layout(_G, true)
}}
MAP
ENDMAP

NAME:   hive_outer_cells
DEPTH:  Hive
