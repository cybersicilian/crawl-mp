# Rounded dens joined by winding passages. Native rock, normal stairs/vaults.
: crawl_require("dlua/vault.lua")
: crawl_require("dlua/layout/minimum_map_area.lua")

NAME:   layout_burrows
DEPTH:  Bur
WEIGHT: 10
ORIENT: encompass
TAGS:   overwritable layout allow_dup unrand layout_type_narrow_caves
{{
    local gxm, gym = dgn.max_bounds()
    extend_map { width=gxm, height=gym, fill='x' }
    local cols = math.max(3, math.floor(gxm / 18))
    local rows = math.max(3, math.floor(gym / 17))
    local nodes = {}

    local function passage(a, b)
        local bend = {
            x=math.floor((a.x+b.x)/2) + crawl.random_range(-3,3),
            y=math.floor((a.y+b.y)/2) + crawl.random_range(-3,3)
        }
        local thickness = crawl.random_range(2,3)
        join_the_dots { x1=a.x, y1=a.y, x2=bend.x, y2=bend.y,
                        thickness=thickness }
        join_the_dots { x1=bend.x, y1=bend.y, x2=b.x, y2=b.y,
                        thickness=thickness }
    end

    for row = 1, rows do
        for col = 1, cols do
            local node = {
                x=8 + math.floor((col-0.5)*(gxm-16)/cols) + crawl.random_range(-2,2),
                y=8 + math.floor((row-0.5)*(gym-16)/rows) + crawl.random_range(-2,2)
            }
            local radius = crawl.random_range(2,4)
            make_circle { x=node.x, y=node.y, radius=radius, fill='.' }
            make_circle { x=node.x+crawl.random_range(-2,2),
                          y=node.y+crawl.random_range(-1,1), radius=2, fill='.' }
            local index = #nodes+1
            nodes[index] = node
            local left = col > 1 and nodes[index-1] or nil
            local above = row > 1 and nodes[index-cols] or nil
            if left and above then
                -- A connected tree, with enough extra links to avoid a maze.
                if crawl.coinflip() then left, above = above, left end
                passage(node, left)
                if crawl.one_chance_in(3) then passage(node, above) end
            elseif left or above then
                passage(node, left or above)
            end
        end
    end
}}
validate {{
    return minimum_map_area.is_map_big_enough(_G, minimum_map_area.NARROW_CAVES)
}}
MAP
ENDMAP
