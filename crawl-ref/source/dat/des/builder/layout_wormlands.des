# Long, exposed galleries with broad passing chambers and stone outcrops.
: crawl_require("dlua/vault.lua")
: crawl_require("dlua/layout/wormlands.lua")
: crawl_require("dlua/layout/minimum_map_area.lua")

NAME:   layout_wormlands
DEPTH:  Worm
WEIGHT: 10
ORIENT: encompass
TAGS:   overwritable layout allow_dup unrand layout_type_narrow_caves
{{
    wormlands_layout(_G)
}}
validate {{
    return minimum_map_area.is_map_big_enough(_G, minimum_map_area.NARROW_CAVES)
}}
MAP
ENDMAP
