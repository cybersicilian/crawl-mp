    {"id": "explore_greedy_visit", "label": "Inspect nearby items", "group": "Travel & rest", "type": "list", "default": ["glowing", "artefact"], "description": "Item types to visit even when you would not pick them up.", "options": ["glowing", "artefact", "stack"], "valueAliases": {"glowing_item": "glowing", "glowing_items": "glowing", "artefacts": "artefact", "artifact": "artefact", "artifacts": "artefact", "stacks": "stack", "pile": "stack", "piles": "stack"}},
