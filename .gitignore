# Reproducible build-time delivery variants; retain original asset sources.
/crawl-ref/source/webserver/static/**/*.br
/crawl-ref/source/webserver/static/**/*.gz
/crawl-ref/source/webserver/static/**/*.lossless.webp
/crawl-ref/source/webserver/static/**/*.lossless.png
/crawl-ref/source/webserver/static/asset-delivery.json
/crawl-ref/source/webserver/game_data/static/**/*.br
/crawl-ref/source/webserver/game_data/static/**/*.gz
/crawl-ref/source/webserver/game_data/static/**/*.lossless.webp
/crawl-ref/source/webserver/game_data/static/**/*.lossless.png
/crawl-ref/source/webserver/game_data/static/asset-delivery.json

# Smoke-test artefacts can hold production account passwords, login tokens and
# server logs (GHSA-5jh6-274c-3x62). Keep them out of the repository and out of
# release tarballs (deploy/package_source.py packages untracked, non-ignored files).
private*.json
docs/diagnostics/**/*.log
docs/diagnostics/**/diagnostic-*.json
docs/diagnostics/**/deploy/
