NAME:   worm_end_troll_mine
PLACE:  Worm:$
ORIENT: encompass
TAGS:   transparent no_item_gen
KFEAT:  O = wormlands_to_depths
KMONS:  G = stone giant
KMONS:  T = iron troll
KMONS:  M = deep troll earth mage
KMONS:  C = coil worm / caustic worm
KITEM:  * = any weapon good_item / any armour good_item / any magical staff good_item / any wand
KITEM:  $ = gold
{{
    local exit, hoard = wormlands_ending(_G, 1)
    mapgrd[exit.x-2][exit.y] = 'G'
    mapgrd[exit.x+2][exit.y+3] = 'T'
    mapgrd[hoard.x][hoard.y] = 'M'
    mapgrd[hoard.x-2][hoard.y] = 'C'
}}
MAP
ENDMAP

NAME:   worm_end_dragon_cavern
PLACE:  Worm:$
ORIENT: encompass
TAGS:   transparent no_item_gen
KFEAT:  O = wormlands_to_depths
KMONS:  D = iron dragon
KMONS:  L = lindwurm
KMONS:  W = gallery worm / caustic worm
KITEM:  * = any weapon good_item / any armour good_item / any magical staff good_item / any wand
KITEM:  $ = gold
{{
    local exit, hoard = wormlands_ending(_G, 2)
    mapgrd[exit.x-2][exit.y] = 'D'
    mapgrd[hoard.x][hoard.y] = 'W'
    mapgrd[hoard.x+2][hoard.y+3] = 'L'
}}
MAP
ENDMAP

