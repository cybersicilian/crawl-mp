NAME:   worm_end_fungal_heart
PLACE:  Worm:$
ORIENT: encompass
TAGS:   transparent no_item_gen
KFEAT:  O = wormlands_to_depths
KMONS:  G = gallery worm
KMONS:  C = coil worm
KMONS:  D = deathcap
KMONS:  M = wandering mushroom
KITEM:  * = any weapon good_item / any armour good_item / any magical staff good_item / any wand
KITEM:  $ = gold
{{
    local exit, hoard = wormlands_ending(_G, 1)
    mapgrd[exit.x-2][exit.y] = 'G'
    mapgrd[exit.x+2][exit.y+3] = 'C'
    mapgrd[hoard.x][hoard.y] = 'D'
    mapgrd[hoard.x-2][hoard.y] = 'M'
}}
MAP
ENDMAP
