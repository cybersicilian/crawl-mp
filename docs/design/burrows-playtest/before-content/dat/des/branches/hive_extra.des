NAME:   hive_end_amber_brood
PLACE:  Hive:$
ORIENT: encompass
TAGS:   transparent no_item_gen
KMONS:  Q = queen bee
KMONS:  W = venom wasp
KMONS:  B = wax beetle
KMONS:  R = killer bee
KITEM:  $ = gold
KITEM:  * = any jewellery good_item / any book / any wand
TILE:   x = wall_wax
COLOUR: x = yellow
{{
    local nodes = hive_layout(_G, true)
    local hoard = nodes[#nodes]
    mapgrd[hoard.x+1][hoard.y+1] = 'B'
    mapgrd[hoard.x-1][hoard.y+1] = 'R'
}}
MAP
ENDMAP
