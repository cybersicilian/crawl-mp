{"files": {"webserver/webtiles/server.py": {"sha256": "b24229da431fa32b869c4a39cf96d2c43e0a846ef2cda28f442357306c691f70", "shutdown_path": "def stop_everything(shutdown_event):\n    # prevent reload signals from interacting with shutdown\n    if config.get('hup_reloads_config'):\n        asyncio.get_event_loop().remove_signal_handler(signal.SIGHUP)\n    asyncio.get_event_loop().remove_signal_handler(signal.SIGUSR1)\n\n    global servers\n    # shut down servers first -- stop accepting new connections\n    for server in servers:\n        server.stop()\n    # shut down ongoing games\n    # XX any errors in this code will prevent shutdown, do something more?\n    ws_handler.shutdown()\n\n    # an open question -- are there cases where even stronger measures might be\n    # needed for stuck processes? task.cancel() handled everything I could think\n    # of locally.\n    def do_stop(tries=0):\n        if len(ws_handler.sockets) == 0:\n            shutdown_event.set()\n        elif tries > 60: # 30s\n            # try something a bit stronger\n            logging.error(\"Stop failed after 30s, cancelling remaining tasks.\")\n            logging.error(\"Remaining sockets: %s\", ws_handler.describe_sockets(names=True))\n            for task in all_tasks_compat():\n                task.cancel()\n        else:\n            IOLoop.current().add_timeout(time.time() + 0.5,\n                functools.partial(do_stop, tries=tries + 1))\n\n    do_stop()"}, "webserver/webtiles/ws_handler.py": {"sha256": "d1c85282588e8683dc789a677b61f10ddecff2898c1e2a9fa243f1f851bd5580", "shutdown_path": "    def shutdown(self):\n        if not self.client_closed:\n            self.logger.info(\"Shutting down user %s id %d\",\n                                    self.username and self.username or \"[Anon]\",\n                                    self.id)\n            msg = to_unicode(self.render_string(\"shutdown.html\", game=self))\n            self.send_message(\"close\", reason=msg, retry=True)\n            self.close(1012, \"Server restarting\")\n        if self.is_running():\n            self.process.stop()\n"}, "webserver/webtiles/process_handler.py": {"sha256": "e464c961d0cf644c75e39522af8203551d296221fb95fac2153e0d3edbf545e6", "shutdown_path": "    def stop(self, delay=False):\n        if delay:\n            IOLoop.current().call_later(0.2, self.stop)\n            return\n        if self.process:\n            self.process.flush_ttyrec()\n            try:\n                self.process.send_signal(signal.SIGHUP)\n            except OSError as e:\n                self.logger.error(f\"Error {repr(e)} on SIGHUP to child process\")\n                self._on_process_end()\n                return\n            t = time.time() + config.get('kill_timeout')\n            self.kill_timeout = IOLoop.current().add_timeout(t, self.kill)\n"}}, "service": "Restart=on-failure\nTimeoutStopUSec=1min\nMainPID=367586\nKillMode=mixed\nActiveState=active\n", "records": [{"id": "985494cc-66da-4451-b1ab-205155ac1672", "owner": "JediJosh", "status": "unfinished", "save_dir": "/var/lib/dcss/rcs/library/saves/985494cc-66da-4451-b1ab-205155ac1672"}, {"id": "15ff5096-0b7e-4125-bb4b-a19643117cb1", "owner": "JediJosh", "status": "fallen", "save_dir": "/var/lib/dcss/rcs/library/saves/15ff5096-0b7e-4125-bb4b-a19643117cb1"}, {"id": "b9c20e7e-0099-45e4-a6ad-6e881f07a231", "owner": "JediJosh", "status": "fallen", "save_dir": "/var/lib/dcss/rcs/library/saves/b9c20e7e-0099-45e4-a6ad-6e881f07a231"}, {"id": "9571a003-9ac4-4cb1-a17e-7211ba158e25", "owner": "JediJosh", "status": "fallen", "save_dir": "/var/lib/dcss/rcs/library/saves/9571a003-9ac4-4cb1-a17e-7211ba158e25"}, {"id": "ec0c7ec8-dc85-401c-a9e4-22c7250c8b44", "owner": "JediJosh", "status": "fallen", "save_dir": "/var/lib/dcss/rcs/library/saves/ec0c7ec8-dc85-401c-a9e4-22c7250c8b44"}, {"id": "0e82768c-08f4-44c8-a999-e17477a18913", "owner": "JediJosh", "status": "fallen", "save_dir": "/var/lib/dcss/rcs/library/saves/0e82768c-08f4-44c8-a999-e1