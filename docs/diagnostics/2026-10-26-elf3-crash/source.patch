diff --git a/crawl-ref/source/dat/dlua/layout/coordinates.lua b/crawl-ref/source/dat/dlua/layout/coordinates.lua
new file mode 100644
index 0000000000..fd4cf97400
--- /dev/null
+++ b/crawl-ref/source/dat/dlua/layout/coordinates.lua
@@ -0,0 +1,35 @@
+-- Encompass layouts use local coordinates and are centered in the native grid.
+-- Existing vault masks and placement bounds use native grid coordinates.
+layout_coordinates = {}
+
+function layout_coordinates.centered(width, height, grid_width, grid_height)
+  local origin_x = math.floor((grid_width - width) / 2)
+  local origin_y = math.floor((grid_height - height) / 2)
+  return {
+    to_local = function(x, y) return x - origin_x, y - origin_y end,
+    to_grid = function(x, y) return x + origin_x, y + origin_y end,
+    contains = function(x_min, x_max, y_min, y_max)
+      return x_min >= 0 and y_min >= 0 and x_max < width and y_max < height
+    end
+  }
+end
+
+function layout_coordinates.builder_frame()
+  local width, height = dgn.max_bounds()
+  -- in_bounds excludes the outer border; max_bounds is only the builder size.
+  -- Probe the allocated grid so this also works with the deployed engine,
+  -- which predates the grid_bounds binding.
+  local grid_width, grid_height = 1, 1
+  while dgn.in_bounds(grid_width, 1) do grid_width = grid_width + 1 end
+  while dgn.in_bounds(1, grid_height) do grid_height = grid_height + 1 end
+  grid_width, grid_height = grid_width + 1, grid_height + 1
+  return layout_coordinates.centered(width, height, grid_width, grid_height)
+end
+
+function layout_coordinates.primary_vault_dimensions(e, frame)
+  local x_min, x_max, y_min, y_max = e.primary_vault_dimensions()
+  if x_min == nil then return end
+  local left, top = frame.to_local(x_min, y_min)
+  local right, bottom = frame.to_local(x_max, y_max)
+  return left, right, top, bottom
+end
diff --git a/crawl-ref/source/test/layout-coordinates.lua b/crawl-ref/source/test/layout-coordinates.lua
new file mode 100644
index 0000000000..5a16ab9230
--- /dev/null
+++ b/crawl-ref/source/test/layout-coordinates.lua
@@ -0,0 +1,42 @@
+crawl_require("dlua/layout/coordinates.lua")
+
+-- Solo through four-player sizes, a full-grid identity, and an odd grid gap.
+for _, size in ipairs({{80, 70}, {94, 82}, {106, 92}, {120, 104}, {81, 71}}) do
+  local width, height = size[1], size[2]
+  local frame = layout_coordinates.centered(width, height, 120, 104)
+  local origin_x, origin_y = frame.to_grid(0, 0)
+  test.eq(origin_x, math.floor((120 - width) / 2))
+  test.eq(origin_y, math.floor((104 - height) / 2))
+  local x, y = frame.to_local(frame.to_grid(width - 1, height - 1))
+  test.eq(x, width - 1)
+  test.eq(y, height - 1)
+
+  local map = {primary_vault_dimensions = function()
+    return origin_x + 2, origin_x + width - 3,
+           origin_y + 3, origin_y + height - 4
+  end}
+  local left, right, top, bottom =
+    layout_coordinates.primary_vault_dimensions(map, frame)
+  test.eq(left, 2)
+  test.eq(right, width - 3)
+  test.eq(top, 3)
+  test.eq(bottom, height - 4)
+  assert(frame.contains(left, right, top, bottom))
+  assert(not frame.contains(-1, right, top, bottom))
+  assert(not frame.contains(left, width, top, bottom))
+  assert(not frame.contains(left, right, -1, bottom))
+  assert(not frame.contains(left, right, top, height))
+  assert(layout_coordinates.primary_vault_dimensions(
+    {primary_vault_dimensions = function() return nil end}, frame) == nil)
+end
+
+local original_max_bounds, original_in_bounds = dgn.max_bounds, dgn.in_bounds
+dgn.max_bounds = function() return 80, 70 end
+dgn.in_bounds = function(x, y)
+  return x > 0 and x < 119 and y > 0 and y < 103
+end
+local frame = layout_coordinates.builder_frame()
+local x, y = frame.to_grid(0, 0)
+test.eq(x, 20)
+test.eq(y, 17)
+dgn.max_bounds, dgn.in_bounds = original_max_bounds, original_in_bounds
diff --git a/crawl-ref/source/test/elf3-gen.lua b/crawl-ref/source/test/elf3-gen.lua
new file mode 100644
index 0000000000..48622c0f57
--- /dev/null
+++ b/crawl-ref/source/test/elf3-gen.lua
@@ -0,0 +1,56 @@
+-- This primary vault plus the castle layout used native coordinates to draw
+-- beyond the smaller solo map. Exercise their real placement before generation.
+debug.reset_rng("11437096116346730075")
+debug.goto_place("Elf:3")
+debug.reset_player_data()
+dgn.reset_level()
+crawl_require("dlua/layout/coordinates.lua")
+local castle = dgn.map_by_name("layout_geoelf_castle")
+for _, name in ipairs({"grunt_elf_hall_asides", "minmay_elf_hall_furrowed"}) do
+  dgn.reset_level()
+  local primary = dgn.map_by_name(name)
+  test.map_assert(dgn.place_map(primary, false, true), "Elf:3 primary placement failed")
+  local frame = layout_coordinates.builder_frame()
+  local x1,x2,y1,y2 = layout_coordinates.primary_vault_dimensions({
+    primary_vault_dimensions = function() return dgn.primary_vault_dimensions(primary) end
+  }, frame)
+  if not frame.contains(x1,x2,y1,y2) then
+    test.map_assert(not dgn.place_map(castle, false, true),
+                    "Castle accepted a primary outside its local grid")
+  end
+end
+
+-- Use an authored floating ending; changing an indexed map's orientation would
+-- be overwritten when its definition is loaded and resolved from the cache.
+dgn.reset_level()
+test.map_assert(dgn.place_map(dgn.map_by_name("elf_hall_gauntlet_wide"),
+                             false, true, 70, 52), "Interior primary placement failed")
+test.map_assert(dgn.place_map(castle, false, true), "Compatible castle placement failed")
+
+-- test.find_feature uses dgn.GXM/GYM, initialized to the smaller builder size.
+-- Search the actual grid: the first return stair can lie beyond that rectangle.
+local function has_return_stairs()
+  local upstairs = dgn.fnum("stone_stairs_up_i")
+  local y = 1
+  while dgn.in_bounds(1, y) do
+    local x = 1
+    while dgn.in_bounds(x, y) do
+      if dgn.grid(x, y) == upstairs then return true end
+      x = x + 1
+    end
+    y = y + 1
+  end
+  return false
+end
+
+-- Include the reported seed without converting its 64-bit value to a Lua float.
+local seeds = {"11437096116346730075", "43"}
+for seed = 1, 24 do seeds[#seeds + 1] = tostring(seed) end
+for _, seed in ipairs(seeds) do
+  debug.reset_rng(seed)
+  test.regenerate_level("Elf:3")
+  test.map_assert(has_return_stairs(),
+                  "Elf:3 has no return stairs for seed " .. seed)
+end
+crawl.stderr("PASS: compatible castle placement, unsafe-placement vetoes and "
+             .. #seeds .. " full Elf:3 generations")
