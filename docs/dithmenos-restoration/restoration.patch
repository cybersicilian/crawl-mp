-    // Check valid shadow spots that are NOT silenced.
-    vector<coord_def> valid_spots = _get_shadow_spots(true);
-
-    // Somehow, nowhere to stand.
-    if (valid_spots.empty())
-        return coord_def();
-
-    coord_def best_spot;
-    int best_score = 0;
