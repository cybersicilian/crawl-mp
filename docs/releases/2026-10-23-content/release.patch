+                return spret::abort;
+            cell = *chosen;
+        }
+        if (!summon(god, god == GOD_FEDHAS ? MONS_BRIAR_PATCH : MONS_ANCESTOR, cell))
+            return spret::abort;
+        break;
+    }
+    case GOD_CHEIBRIADOS:
+        for (monster_near_iterator mon(you.pos(), LOS_NO_TRANS); mon; ++mon)
