+#include "AppHdr.h"
+#include "eldritch.h"
+#include "god-vellum.h"
+
+#include "artefact.h"
+#include "delay.h"
+#include "env.h"
+#include "terrain.h"
+#include "item-prop.h"
+#include "items.h"
+#include "message.h"
+#include "nearby-danger.h"
+#include "player.h"
+#include "religion.h"
+#include "store.h"
