+        break;
+    case GOD_OKAWARU:
+        you.duration[DUR_ELDER_HEROISM] = 60;
+        break;
+    case GOD_SIF_MUNA:
+        if (you.magic_points == you.max_magic_points)
+            return spret::abort;
+        inc_mp(1 + rank());
+        start_delay<ElderChannel>(1 + rank());
+        break;
+    case GOD_TROG:
+        if (!you.go_berserk(true))
+            return spret::abort;
+        you.duration[DUR_BERSERK] = (4 + rank()) * BASELINE_DELAY;
