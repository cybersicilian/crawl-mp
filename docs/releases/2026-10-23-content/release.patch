+spret invoke_power(god_type god, dist* target)
+{
+    if (!reason(ability(god)).empty())
+        return spret::abort;
+    if (god == GOD_VELLUM)
+        return borrow_thread();
+    if (god == GOD_GOZAG)
+        return petition();
+#if TAG_MAJOR_VERSION == 34
+    if (god == GOD_PAKELLAS)
+        return wand_surge(target);
