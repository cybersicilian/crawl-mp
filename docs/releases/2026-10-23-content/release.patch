+            return spret::abort;
+        bool enemy = false;
+        for (adjacent_iterator adjacent(*cell); adjacent; ++adjacent)
+            enemy |= hostile_at(*adjacent) != nullptr;
+        if (!enemy || !check_moveto(*cell, "shadow step", false, false))
+            return spret::abort;
+        if (!you.blink_to(*cell))
+            return spret::abort;
+        break;
