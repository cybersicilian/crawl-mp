+    if (owner.props.exists("eldritch_rite_floor")
+        && owner.props["eldritch_rite_floor"].get_string() != floor_of(owner))
+    {
+        owner.props.erase("eldritch_rite_active");
+        owner.props.erase("eldritch_rite_floor");
