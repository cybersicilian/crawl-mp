+    case GOD_IGNIS:
+        you.duration[DUR_ELDER_ARMOUR] = 80;
+        break;
+    default:
+        return spret::abort;
+    }
+    if (result == spret::success)
+    {
+        spend(price);
+        you.redraw_armour_class = you.redraw_evasion = you.redraw_status_lights = true;
+    }
+    return result;
+}
