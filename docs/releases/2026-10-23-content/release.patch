+            result = cast_smiting(12 + skill_bump(SK_INVOCATIONS, 6, true), victim, false, percent());
+        else if (god == GOD_LUGONU)
+        {
+            bolt beam;
+            beam.source = you.pos();
+            beam.target = *cell;
+            beam.range = LOS_RADIUS;
+            result = zapping(ZAP_BANISHMENT, (68 + you.skill(SK_INVOCATIONS, 3)) * percent() / 100,
