# Git metadata (keep .git if version string generation needs it, but ignore heavy pack/logs if any)
.git/logs/
*.o
*.d
*.a
*.so
*.dylib
*.DS_Store
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/

# Existing local build artifacts and runtime state
crawl-ref/source/crawl
crawl-ref/source/*.o
crawl-ref/source/*.d
crawl-ref/source/rcs/
crawl-ref/source/saves/
crawl-ref/source/morgue/
crawl-ref/source/webserver/run/
crawl-ref/source/util/
crawl-ref/source/rltiles/*.o
crawl-ref/source/rltiles/*.png
!crawl-ref/source/rltiles/**/*.png

# Local deployment tarballs and logs
*.tar.gz
*.tgz
*.log

crawl-ref/source/webserver/static/.css-bundles/
crawl-ref/source/webserver/static/stylesheet-bundle-index.json
crawl-ref/source/webserver/game_data/static/.css-bundles/
crawl-ref/source/webserver/game_data/static/stylesheet-bundle-index.json

# Prepared after the native atlas build for this target platform.
crawl-ref/source/webserver/static/**/*.br
crawl-ref/source/webserver/static/**/*.gz
crawl-ref/source/webserver/static/**/*.lossless.webp
crawl-ref/source/webserver/static/**/*.lossless.png
crawl-ref/source/webserver/static/asset-delivery.json
crawl-ref/source/webserver/game_data/static/**/*.br
crawl-ref/source/webserver/game_data/static/**/*.gz
crawl-ref/source/webserver/game_data/static/**/*.lossless.webp
crawl-ref/source/webserver/game_data/static/**/*.lossless.png
crawl-ref/source/webserver/game_data/static/asset-delivery.json
